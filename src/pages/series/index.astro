---
/**
 * Series index — lists every series with a count. Each links to its own page.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_URL } from "../../consts";
import { getAllSeries } from "../../utils/essays";

const series = await getAllSeries();
---

<BaseLayout
  title="Series"
  description={`Essay series by ${SITE_TITLE}.`}
  canonical={SITE_URL + "/series"}
  wide
>
  <h1>Series</h1>
  {
    series.length === 0 ? (
      <p class="muted">No series yet.</p>
    ) : (
      <ul class="index-list">
        {series.map((s) => (
          <li>
            <a href={`/series/${s.series}`}>{s.series}</a>
            <span class="faint small">
              {s.count} essay{s.count === 1 ? "" : "s"}
            </span>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .index-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .index-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }
  .index-list a {
    font-size: 1.2rem;
    text-decoration: none;
    color: var(--fg);
  }
  .index-list a:hover {
    color: var(--accent);
  }
</style>
