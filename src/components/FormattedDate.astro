---
/**
 * Renders a Date as a machine-readable <time> element with human text.
 * Centralizing this keeps date formatting identical everywhere.
 */
interface Props {
  date: Date;
}
const { date } = Astro.props;
const iso = date.toISOString();
const human = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<time datetime={iso}>{human}</time>
